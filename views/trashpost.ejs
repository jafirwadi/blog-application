<%- include('partials/header') %>

<div class="page-wrapper">

  <aside class="sidebar">
    <div class="sidebar-logo">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#2196F3" viewBox="0 0 16 16">
        <path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4z"/>
        <path d="M4.5 4h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1 0-1z"/>
      </svg>
      <span class="sidebar-logo-text">Blog App</span>
    </div>

    <nav class="sidebar-nav">
      <a href="/" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6-.002.002-.002.001-.003.003-.004.003a.5.5 0 0 0 .67.737L2 7.64V12.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V7.64l.695.251a.5.5 0 1 0 .34-.933L13 6.58V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.276L8.354 1.146zM13 7.22V12.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.22l4.5-1.621 5.5 1.621z"/>
        </svg>
        All Posts
        <% if (PostCount > 0) { %>
          <span class="sidebar-post-count-badge"><%= PostCount %></span> 
          <% } %>
      </a>
      <a href="/drafts" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z"/>
        </svg>
        Drafts
        <% if (DraftCount > 0) { %>
          <span class="sidebar-post-count-badge"><%= DraftCount %></span> 
        <% } %>
      </a>
      <a href="/trash" class="sidebar-link active">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
          <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
        </svg>
        Trash
        <% if (TrashCount > 0) { %> 
          <spean class="sidebar-post-count-badge"><%= TrashCount %> </spean>
        <% } %>
      </a>
    </nav>
  </aside>

<main class="home-main">

    <div class="home-hero">
      <div>
        <h1 class="home-heading">Trash</h1>
        <p class="home-subheading">All your deleted posts in one place. Restore or delete permanently. Do nothing will delete the posts permanently after a certain period of time</p>
      </div>
    </div>

  <div class="home-content">
      <% if (allTrashDatas.length > 0) { %>
        <div class="blog-grid">
          <% allTrashDatas.forEach(allTrashData => { %>
            <div class="post-card">
              <div class="post-card-body">
                <h3 class="post-card-title"><%= allTrashData.postTitle %></h3>
                <p class="post-card-date"><%= allTrashData.deletedAtFormatted %></p>
                <p class="post-card-excerpt"><%- allTrashData.excerpt %></p>
              </div>
              <div class="post-card-footer">            

               <div class="card-actions">
                <span class="bi bi-trash"><a href="/restore-post?id=<%= allTrashData.postID %>" class="card-action-btn" title="Restore"><svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
                <path d="M8 3a5 5 0 1 0 4.546 2.914.5.5 0 0 1 .908-.417A6 6 0 1 1 8 2v1z"/>
                <path d="M8 4.466V.534a.25.25 0 0 1 .41-.192l2.36 1.966c.12.1.12.284 0 .384L8.41 4.658A.25.25 0 0 1 8 4.466z"/>
                </svg></a></span>
                
                <span class="bi bi-trash"><a href="#" onclick="deletePost('<%= allTrashData.postID %>', '/trash')"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                </svg></a></span>
               </div> 
               
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#d1d5db" viewBox="0 0 16 16">
            <path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4z"/>
            <path d="M4.5 4h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1 0-1z"/>
          </svg>
          <h3 class="empty-title">Great! No Posts has been deleted Yet</h3>          
        </div>
      <% } %>

    </main> 
</div>


<script src="/scripts/modal.js"></script>