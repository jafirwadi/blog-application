<%- include("partials/header.ejs") %>

<div class="page-wrapper">

  <aside class="sidebar">
    <div class="sidebar-logo">
      <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="#2196F3" viewBox="0 0 16 16">
        <path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4z"/>
        <path d="M4.5 4h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1 0-1z"/>
      </svg>
      <span class="sidebar-logo-text">Tanzim's Blog</span>
    </div>

    <nav class="sidebar-nav">
      <a href="/" class="sidebar-link active">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8.354 1.146a.5.5 0 0 0-.708 0l-6 6-.002.002-.002.001-.003.003-.004.003a.5.5 0 0 0 .67.737L2 7.64V12.5A1.5 1.5 0 0 0 3.5 14h9a1.5 1.5 0 0 0 1.5-1.5V7.64l.695.251a.5.5 0 1 0 .34-.933L13 6.58V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.276L8.354 1.146zM13 7.22V12.5a.5.5 0 0 1-.5.5h-9a.5.5 0 0 1-.5-.5V7.22l4.5-1.621 5.5 1.621z"/>
        </svg>
        All Posts
        <% if (PostCount > 0) { %>
          <span class="sidebar-post-count-badge"><%= PostCount %></span> 
          <% } %>
      </a>
      <a href="/drafts" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M13.5 1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3zM11 2.5a2.5 2.5 0 1 1 .603 1.628l-6.718 3.12a2.499 2.499 0 0 1 0 1.504l6.718 3.12a2.5 2.5 0 1 1-.488.876l-6.718-3.12a2.5 2.5 0 1 1 0-3.256l6.718-3.12A2.5 2.5 0 0 1 11 2.5z"/>
        </svg>
        Drafts
        <% if (DraftCount > 0) { %>
          <span class="sidebar-post-count-badge"><%= DraftCount %></span> 
        <% } %>
      </a>
      <a href="/trash" class="sidebar-link">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
          <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
          <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
        </svg>
        Trash
        <% if (TrashCount > 0) { %> 
          <spean class="sidebar-post-count-badge"><%= TrashCount %> </spean>
        <% } %>
      </a>
    </nav>
  </aside>

  <main class="home-main">

    <div class="home-hero">
      <div>
        <h1 class="home-heading">My Blogs</h1>
        <p class="home-subheading">All your published posts in one place.</p>
      </div>
      <% if (locals.searchQuery) { %>
        <p class="search-feedback">
          Search results for "<Strong><%= searchQuery %></Strong>"
          <a href="/" class="clear-search">Clear</a>
        </p>
      <% } %>
      <div class="home-right">
        <form action="/search" method="GET" class="search-form">
          <input type="text" name="q" class="search-input" placeholder="Search posts...">
          <button type="submit" class="search-btn">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor" viewBox="0 0 16 16">
            <path d="M11.742 10.344a6.5 6.5 0 1 0-1.397 1.398h-.001c.03.04.062.078.098.115l3.85 3.85a1 1 0 0 0 1.415-1.414l-3.85-3.85a1.007 1.007 0 0 0-.115-.099zm-5.242 1.656a5.5 5.5 0 1 1 0-11 5.5 5.5 0 0 1 0 11z"/>
            </svg>
          </button>
        </form>

        <button type="button" onclick="window.location.href='/new-post'" class="btn-publish">
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16">
          <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14zm0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16z"/>
          <path d="M8 4a.5.5 0 0 1 .5.5v3h3a.5.5 0 0 1 0 1h-3v3a.5.5 0 0 1-1 0v-3h-3a.5.5 0 0 1 0-1h3v-3A.5.5 0 0 1 8 4z"/>
        </svg>
        New Post
        </button>
      </div>
    </div>

    <div class="home-content">
      <% if (allPostDatas.length > 0) { %>
        <div class="blog-grid">
          <% allPostDatas.forEach(allPostData => { %>
            <div class="post-card">
              <div class="post-card-body">
                <h3 class="post-card-title"><%= allPostData.postTitle %></h3>
                <p class="post-card-date"><%= allPostData.createdAt %></p>
                <p class="post-card-excerpt"><%= allPostData.excerpt %></p>
              </div>
              <div class="post-card-footer">
                <button
                  type="button"
                  class="btn-read-more"
                  onclick="window.location.href='/read-more?id=<%= allPostData.postID %>'">
                  Read more
                </button>

               <div class="card-actions">
                <span class="bi bi-trash"><a href="/edit-post?id=<%= allPostData.postID %>&from=home"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-pencil" viewBox="0 0 16 16">
                <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325"/>
                </svg></a></span>
                <span class="bi bi-trash"><a href="#" onclick="deletePost('<%= allPostData.postID %>', '/')"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-trash" viewBox="0 0 16 16">
                <path d="M5.5 5.5A.5.5 0 0 1 6 6v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m2.5 0a.5.5 0 0 1 .5.5v6a.5.5 0 0 1-1 0V6a.5.5 0 0 1 .5-.5m3 .5a.5.5 0 0 0-1 0v6a.5.5 0 0 0 1 0z"/>
                <path d="M14.5 3a1 1 0 0 1-1 1H13v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V4h-.5a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1H6a1 1 0 0 1 1-1h2a1 1 0 0 1 1 1h3.5a1 1 0 0 1 1 1zM4.118 4 4 4.059V13a1 1 0 0 0 1 1h6a1 1 0 0 0 1-1V4.059L11.882 4zM2.5 3h11V2h-11z"/>
                </svg></a></span>
               </div> 
               
              </div>
            </div>
          <% }); %>
        </div>
      <% } else { %>
        <div class="empty-state">
          <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" fill="#d1d5db" viewBox="0 0 16 16">
            <path d="M4 0h8a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V2a2 2 0 0 1 2-2zm0 1a1 1 0 0 0-1 1v12a1 1 0 0 0 1 1h8a1 1 0 0 0 1-1V2a1 1 0 0 0-1-1H4z"/>
            <path d="M4.5 4h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h7a.5.5 0 0 1 0 1h-7a.5.5 0 0 1 0-1zm0 3h4a.5.5 0 0 1 0 1h-4a.5.5 0 0 1 0-1z"/>
          </svg>
          <h3 class="empty-title">No Blog Posts Yet</h3>
          <p class="empty-desc">You haven't published anything yet. Start writing your first post!</p>
          <button type="button" onclick="window.location.href='/new-post'" class="btn-publish" style="margin-top: 16px;">
            + Write your first post
          </button>
        </div>
      <% } %>
    </div>

  </main>

</div>

<script src="/scripts/modal.js"></script>

<%- include("partials/footer.ejs") %>